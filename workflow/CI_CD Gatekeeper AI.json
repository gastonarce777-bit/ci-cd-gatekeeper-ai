    {
      "parameters": {
        "jsCode": "// Obtenemos la respuesta en texto de Claude\nconst rawText = $input.first().json.content[0].text;\n\n// Convertimos el texto JSON a un objeto de JavaScript\nconst reviewData = JSON.parse(rawText);\n\n// Extraemos los datos originales del webhook para saber qué PR estamos evaluando\nconst webhookBody = $('Webhook').first().json.body;\n\nreturn [\n  {\n    json: {\n      repoFullName: webhookBody.repository.full_name,\n      prNumber: webhookBody.number,\n      hasIssues: reviewData.has_issues,\n      severity: reviewData.severity,\n      summary: reviewData.review_summary,\n      feedbackItems: reviewData.feedback_items\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -128
      ],
      "id": "b7f57473-344e-4a05-b80e-97e49235af9e",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nlet markdown = `## 🤖 AI Code Review & Gatekeeper Report\\n\\n`;\nmarkdown += `**Estado:** ${data.hasIssues ? '⚠️ Se encontraron observaciones' : '✅ Código aprobado'}\\n`;\nmarkdown += `**Severidad:** \\`${data.severity}\\`\\n\\n`;\nmarkdown += `### 📝 Resumen de la revisión\\n${data.summary}\\n\\n`;\n\nif (data.feedbackItems && data.feedbackItems.length > 0) {\n  markdown += `### 🔍 Detalles y Soluciones Propuestas\\n\\n`;\n  data.feedbackItems.forEach((item, index) => {\n    markdown += `#### ${index + 1}. [${item.type}] - \\`${item.file}\\`\\n`;\n    markdown += `**Problema:** ${item.issue}\\n\\n`;\n    markdown += `**Propuesta de solución (Fix):**\\n\\`\\`\\`markdown\\n${item.fix_proposal}\\n\\`\\`\\`\\n\\n`;\n  });\n}\n\n// Generamos los JSON del body ya escapados adecuadamente\nconst bodyApprove = JSON.stringify({\n  event: \"APPROVE\",\n  body: markdown\n});\n\nconst bodyReject = JSON.stringify({\n  event: \"REQUEST_CHANGES\",\n  body: markdown\n});\n\nreturn [\n  {\n    json: {\n      ...data,\n      markdownComment: markdown,\n      jsonBodyApprove: bodyApprove,\n      jsonBodyReject: bodyReject\n    }\n  }\n];"
      },
